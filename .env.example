# SENTINEL Ultimate - Docker Compose Environment
# Copy to .env and customize
# NEVER commit this file with real secrets!

# ---------------------------------------------------------
# REQUIRED - GENERATE BEFORE DEPLOYMENT
# ---------------------------------------------------------
# Generate with: python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
SENTINEL_MASTER_KEY=

# ---------------------------------------------------------
# OIDC / IDENTITY PROVIDER (REQUIRED FOR PRODUCTION)
# ---------------------------------------------------------
# Keycloak, Auth0, Azure AD, etc.
SENTINEL_OIDC_ISSUER=https://identity.example.invalid/realms/sentinel
SENTINEL_OIDC_AUDIENCE=sentinel-api
SENTINEL_OIDC_JWKS_URL=https://identity.example.invalid/realms/sentinel/protocol/openid-connect/certs

# ---------------------------------------------------------
# REDIS
# ---------------------------------------------------------
REDIS_PASSWORD=changeme

# ---------------------------------------------------------
# SURICATA FORWARDER
# ---------------------------------------------------------
SENTINEL_EVENTS_TOKEN=changeme

# ---------------------------------------------------------
# GRAFANA
# ---------------------------------------------------------
GRAFANA_PASSWORD=changeme