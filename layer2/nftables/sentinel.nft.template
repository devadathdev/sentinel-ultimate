#!/usr/sbin/nft -f
# SENTINEL Layer 2 — Network Fortress
# Replace interface names and zone CIDRs for your deployment.

flush table inet sentinel

table inet sentinel {
  set trusted_admins { type ipv4_addr; flags interval; elements = { 10.10.50.0/24 } }

  chain input {
    type filter hook input priority filter; policy drop;
    ct state established,related accept
    iifname "lo" accept
    ip saddr @trusted_admins tcp dport {22,443} accept
    ip protocol icmp accept
    counter name input_drops
    log prefix "SENTINEL-L2 INPUT-DROP " flags all counter
  }

  chain forward {
    type filter hook forward priority filter; policy drop;
    ct state established,related accept

    # User -> AI / Server
    ip saddr 10.10.10.0/24 ip daddr 10.10.20.0/24 tcp dport 443 accept
    ip saddr 10.10.10.0/24 ip daddr 10.10.30.0/24 tcp dport 443 accept

    # AI -> Server
    ip saddr 10.10.20.0/24 ip daddr 10.10.30.0/24 tcp dport {443,8443} accept

    # Server -> Data
    ip saddr 10.10.30.0/24 ip daddr 10.10.60.0/24 tcp dport {5432,6379} accept

    # Management -> privileged services
    ip saddr 10.10.50.0/24 ip daddr 10.10.30.0/24 tcp dport {22,443,8443} accept
    ip saddr 10.10.50.0/24 ip daddr 10.10.20.0/24 tcp dport {22,443,8443} accept

    # IoT -> AI gateway only
    ip saddr 10.10.40.0/24 ip daddr 10.10.20.0/24 tcp dport {443,8883} accept

    # DNS to approved resolver; replace resolver address.
    ip saddr {10.10.10.0/24,10.10.20.0/24,10.10.30.0/24,10.10.40.0/24,10.10.50.0/24,10.10.60.0/24} ip daddr 10.10.50.53 udp dport 53 accept

    counter name forward_drops
    log prefix "SENTINEL-L2 FORWARD-DROP " flags all counter
  }

  chain output {
    type filter hook output priority filter; policy accept;
  }
}
